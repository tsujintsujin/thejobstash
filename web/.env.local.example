# Copy to .env.local and fill in. Next.js loads .env.local automatically and
# it is never committed. Nothing here is needed to run the site - sign-in with
# an email and password works without any of it.

# --- Google sign-in -------------------------------------------------------
# Both must be set or the Google button stays disabled. See README, "Google
# sign-in", for where these come from.
JOBSTASH_GOOGLE_CLIENT_ID=
JOBSTASH_GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered on the OAuth client EXACTLY - Google
# compares the whole string, including the port and the lack of a trailing
# slash. Only needed away from the default dev server.
# JOBSTASH_GOOGLE_REDIRECT_URI=https://thejobstash.example/api/auth/google/callback

# --- testing only ---------------------------------------------------------
# Points sign-in at the local stand-in for Google used by e2e_google.sh, so
# the flow can be exercised without a real OAuth client. A production build
# refuses to start with this set: a live server that can be told where to go
# and ask whether a password is correct is an authentication bypass.
# Do NOT put this in .env.local - pass it when starting the test server.
# JOBSTASH_GOOGLE_STUB_ORIGIN=http://localhost:3210

# --- email (sign-up codes) --------------------------------------------------
# Brevo transactional API. Unset, `next dev` prints the code to the console
# instead of sending it. In production this is a Worker secret, not a file.
# JOBSTASH_BREVO_KEY=
# JOBSTASH_FROM_EMAIL=noreply@thejobstash.com
